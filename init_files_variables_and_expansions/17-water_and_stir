#!/bin/bash

build_map() {
    local word="$1"
    local -n _map=$2
    local base=0
    local i c
    for ((i = 0; i < ${#word}; i++)); do
        c="${word:i:1}"
        if [[ -z "${_map[$c]+x}" ]]; then
            _map[$c]=$base
            base=$((base + 1))
        fi
    done
}

build_rev() {
    local -n _map=$1
    local -n _rev=$2
    local k
    for k in "${!_map[@]}"; do
        _rev[${_map[$k]}]=$k
    done
}

decode() {
    local -n _map=$1
    local base="$2"
    local str="$3"
    local value=0
    local i c
    for ((i = 0; i < ${#str}; i++)); do
        c="${str:i:1}"
        value=$((value * base + _map[$c]))
    done
    echo "$value"
}

encode() {
    local -n _rev=$1
    local base="$2"
    local num="$3"
    local result=""
    local rem
    if [[ "$num" -eq 0 ]]; then
        echo "${_rev[0]}"
        return
    fi
    while [[ "$num" -gt 0 ]]; do
        rem=$((num % base))
        result="${_rev[$rem]}${result}"
        num=$((num / base))
    done
    echo "$result"
}

declare -A w_map s_map o_map o_rev

build_map "water" w_map
build_map "stir" s_map
build_map "bestchol" o_map
build_rev o_map o_rev

water_base=${#w_map[@]}
stir_base=${#s_map[@]}
out_base=${#o_map[@]}

water_dec=$(decode w_map "$water_base" "$WATER")
stir_dec=$(decode s_map "$stir_base" "$STIR")

total=$((water_dec + stir_dec))

encode o_rev "$out_base" "$total"
